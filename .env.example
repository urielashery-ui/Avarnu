# ---- חובה ----
NODE_ENV=production
# מפתח הצפנה (64 תווים). יוצרים עם: npm run keygen
# חשוב: לשמור עותק במקום בטוח. בלי המפתח אי אפשר לקרוא את הפניות.
DATA_KEY=
# כניסה למסך הניהול (/admin)
ADMIN_USER=admin
ADMIN_PASS=
# הכתובת של האתר (לקישורים במיילים)
PUBLIC_URL=https://avarnu.com

# ---- מיילים (לא חובה) ----
# לדוגמה: smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=עברנו <no-reply@avarnu.com>
# לאן לשלוח התראה על כל פנייה חדשה
NOTIFY_TO=

# ---- חיבור ל-CRM / Make / Zapier (לא חובה) ----
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- שונות ----
PORT=3000
DB_PATH=data/movers.db
# כמה ימים אחרי תאריך המעבר למחוק פניות
RETENTION_DAYS=180
# כמה פניות מותר לשלוח מאותה כתובת IP ברבע שעה
RATE_LIMIT=10

# ---- פרסום ושותפים (כבוי) ----
# להפעלה: מעתיקים את config/sponsors.example.json ל-config/sponsors.json, ממלאים, ומשנים ל-true
ADS_ENABLED=false
SPONSORS_FILE=config/sponsors.json

# ---- תשלום (כבוי — היום השירות בחינם) ----
PAYMENTS_ENABLED=false
# הספק שמחובר ב-server/payments (למשל grow / cardcom / payplus אחרי שנכתוב אותו). mock לבדיקות בלבד.
PAYMENT_PROVIDER=none
# מחיר בשקלים. 0 = חינם
PRICE_CONCIERGE=0
PRICE_SELF=0
# אחרי כמה שעות למחוק פנייה שלא שולמה
PENDING_PAYMENT_HOURS=48

# ---- תזכורות על פרטים חסרים ----
# אחרי כמה שעות לשלוח את התזכורת הראשונה (השנייה נשלחת ביום המעבר)
REMIND_AFTER_HOURS=24

# ---- תיאום שיחה עם נציג של גוף ----
# נציג שלך ממתין על הקו ומחבר את הלקוח. להפעיל רק כשיש מי שעושה את זה.
CALLBACK_ENABLED=false

# ---- קרטונים וחומרי אריזה ----
# כבוי: הלקוח מקבל חישוב של כמה צריך + רשימת קניות (ואם ביקש מובילים — הם יכולים להביא).
# פעיל: אפשר גם להזמין משלוח עד הבית. ההזמנה נשלחת במייל לספק ב-SUPPLIES_TO.
# אם SUPPLIES_TO ריק, ההזמנה מופיעה אצלך כמשימה במסך הניהול ומזמינים ידנית.
SUPPLIES_ENABLED=false
SUPPLIES_TO=

# ---- פיילוט מובילים ----
# להפעיל אחרי שיש לפחות 3 מובילים פעילים ב-/admin/movers
MOVERS_ENABLED=false
# לכמה מובילים לשלוח כל בקשה (1-5)
MOVERS_PER_LEAD=3
# כמה ימים אחרי המעבר לבקש דירוג
REVIEW_DELAY_DAYS=3
# ממתי מציגים ציון ממוצע (מספר ביקורות מאושרות)
MIN_REVIEWS_TO_SHOW=3

# ---- שפות ----
# באילו שפות הנציגים שלכם מדברים (מוצג ללקוח בשלב השליחה). he,en,ru,ar
SUPPORT_LANGS=he
